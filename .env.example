# ================================================================
# PENGATURAN ANALYTICS — salin berkas ini menjadi .env
#
#   cp .env.example .env
#
# ⚠️ .env TIDAK ikut ter-commit ke GitHub (sudah ada di .gitignore).
#    Untuk Netlify/Vercel/GitHub Pages, isi nilai yang sama lewat
#    pengaturan Environment Variables di dasbor masing-masing.
#
# ⚠️ Setiap kali .env diubah, dev server HARUS dijalankan ulang.
#    Vite hanya membaca .env saat start.
# ================================================================

# Pilihan: none | umami | plausible
VITE_ANALYTICS_PROVIDER=none

# ── UMAMI (disarankan — gratis s/d 100.000 kunjungan per bulan) ──
# 1. Daftar di https://cloud.umami.is  (tanpa kartu kredit)
# 2. Add website → isi domain Torgas
# 3. Salin "Website ID" dari menu Settings ke bawah ini
# 4. Ubah VITE_ANALYTICS_PROVIDER di atas menjadi: umami
VITE_UMAMI_WEBSITE_ID=
# Kosongkan kalau memakai Umami Cloud. Isi hanya bila self-host.
VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# ── PLAUSIBLE (alternatif berbayar, mulai USD 9/bulan) ──
# Isi dengan domain yang didaftarkan di Plausible, tanpa https://
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
